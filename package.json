{
  "name": "worktop",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "Worktop — 个人 AI 工作台:对话、文件、浏览器与应用",
  "author": "woodchange",
  "main": "desktop/main.js",
  "scripts": {
    "postinstall": "node ./scripts/fix-node-pty-permissions.mjs",
    "start": "tsx ./index.ts",
    "dev": "tsx watch ./index.ts",
    "ui": "vite --config ui/vite.config.ts ui",
    "build": "vite --config ui/vite.config.ts build ui",
    "build:server": "node scripts/build-server.mjs server",
    "build:updater": "node scripts/build-server.mjs updater",
    "app": "npm run build && npm run build:server && electron .",
    "icon": "node scripts/make-icon.mjs",
    "prepare:node": "node scripts/prepare-node.mjs",
    "dist:mac": "npm run build && npm run build:server && npm run build:updater && npm run icon && npm run prepare:node && electron-builder --mac",
    "app:mac": "rm -rf release/mac-arm64 && npm run build && npm run build:server && npm run build:updater && npm run icon && npm run prepare:node && electron-builder --mac --dir",
    "typecheck": "tsc --noEmit",
    "test:routes": "tsx --test tests/host-routes.test.ts",
    "dist:win": "npm run build && npm run build:server && npm run build:updater && npm run icon && npm run prepare:node && electron-builder --win --x64",
    "app:win": "npm run build && npm run build:server && npm run build:updater && npm run icon && npm run prepare:node && electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "ai.iimos.worktop",
    "productName": "Worktop",
    "afterSign": "scripts/notarize.cjs",
    "publish": [
      {
        "provider": "generic",
        "url": "https://r2.iimos.ai/worktop/mac-arm64"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/server.mjs",
        "to": "core/server.mjs"
      },
      {
        "from": "desktop/chromeExtract.mjs",
        "to": "core/chromeExtract.mjs"
      },
      {
        "from": "ui/dist",
        "to": "core/ui"
      },
      {
        "from": "resources",
        "to": "core/resources"
      },
      {
        "from": "dist/node-runtime",
        "to": "core/bin"
      },
      {
        "from": "node_modules/node-pty",
        "to": "core/node_modules/node-pty"
      },
      {
        "from": "node_modules/node-addon-api",
        "to": "core/node_modules/node-addon-api"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "desktop/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "Chuan Zhi (Chengdu) Information Technology Co., Ltd. (92696T726U)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/build/entitlements.mac.plist",
      "entitlementsInherit": "desktop/build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "publish": [
        {
          "provider": "generic",
          "url": "https://r2.iimos.ai/worktop/win-x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Worktop"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@dnd-kit/core": "^6.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.4",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.0"
  }
}
